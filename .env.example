# Copy to .env and fill in what you have. Everything is optional: with no
# keys the system runs end to end with extractive answers, browser speech,
# and the simulated streaming recogniser for Q4.

# Server
PORT=3000
HOST=127.0.0.1
# If set, every /api call needs "Authorization: Bearer <token>" and the
# real-time socket needs {"type":"auth","token":"..."} first.
DEMO_ACCESS_TOKEN=
RATE_LIMIT_PER_MINUTE=120
# info (default) or silent
LOG_LEVEL=info

# LLM (grounded answer phrasing; optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=2500
# "off" forces extractive answers even with a key
LLM_MODE=
# "on" lets the LLM shorten nudge text (800 ms timeout, template on failure)
NUDGE_LLM=

# Streaming ASR for Q4 replays (optional; UNTESTED, see GAPS.md GAP-009)
# ASR_MODE=deepgram plus a key switches from the simulated recogniser.
ASR_MODE=
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Escalation webhook (optional): POSTed {type:"escalation", lead} on transfer
ESCALATION_WEBHOOK_URL=

# Key for the HMAC used to reference customer records without storing them.
# Set a long random value in any shared environment.
PII_HASH_KEY=

# Headless Chromium for npm run ui:smoke / record:demo
CHROME_PATH=
